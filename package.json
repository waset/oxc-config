{
  "name": "@waset/oxc-config",
  "version": "0.1.0",
  "description": "Shared native Oxlint and Oxfmt configuration for JavaScript, TypeScript, Vue and Nuxt",
  "keywords": [
    "config",
    "nuxt",
    "oxc",
    "oxfmt",
    "oxlint",
    "vue"
  ],
  "homepage": "https://github.com/waset/oxc-config",
  "bugs": {
    "url": "https://github.com/waset/oxc-config/issues"
  },
  "license": "MIT",
  "author": "waset",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waset/oxc-config.git"
  },
  "files": [
    "oxlint",
    "oxfmt",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./oxlint/index.d.mts",
      "default": "./oxlint/index.mjs"
    },
    "./oxlint/vue": {
      "types": "./oxlint/vue.d.mts",
      "default": "./oxlint/vue.mjs"
    },
    "./oxfmt": {
      "types": "./oxfmt/index.d.mts",
      "default": "./oxfmt/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "smoke": "node scripts/check.mjs"
  },
  "devDependencies": {
    "lint-staged": "16.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.90.0",
    "simple-git-hooks": "2.14.0"
  },
  "peerDependencies": {
    "oxfmt": "~0.74.0",
    "oxlint": "^1.89.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm lint && pnpm format:check",
    "preserveUnused": true
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,tsx,jsx,vue}": [
      "oxlint -c oxlint.config.mjs --fix --no-error-on-unmatched-pattern",
      "oxfmt -c oxfmt.config.mjs --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.mjs -f stylish --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css,scss,less}": [
      "oxfmt -c oxfmt.config.mjs --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
